--- a/src/pbrt/cameras.cpp
+++ b/src/pbrt/cameras.cpp
@@ -612,6 +612,19 @@ PBRT_CPU_GPU pstd::optional<CameraRay> SphericalCamera::GenerateRay(CameraSample
     // Compute spherical camera ray direction
     Point2f uv(sample.pFilm.x / film.FullResolution().x,
                sample.pFilm.y / film.FullResolution().y);
+    if (ods) {
+        // equirectangular, image centre looks along 'yaw' (radians, from +x towards +y),
+        // u increasing = turning right; world is right-handed with z up
+        Float theta = Pi * uv[1];
+        Float az = yaw - 2 * Pi * (uv[0] - 0.5f);
+        Float st = std::sin(theta);
+        Vector3f d(st * std::cos(az), st * std::sin(az), std::cos(theta));
+        Vector3f right(std::sin(az), -std::cos(az), 0);
+        Float s = st * st;  // fade stereo base towards the poles
+        Point3f o = eyePos + right * (Float(eye) * 0.5f * ipd * s);
+        Ray ray(o, Normalize(d), SampleTime(sample.time), medium);
+        return CameraRay{RenderFromCamera(ray)};
+    }
     Vector3f dir;
     if (mapping == EquiRectangular) {
         // Compute ray direction using equirectangular mapping
@@ -683,7 +696,17 @@ SphericalCamera *SphericalCamera::Create(const ParameterDictionary &parameters,
                   "\"equalarea\" or \"equirectangular\".)",
                   m);
 
-    return alloc.new_object<SphericalCamera>(cameraBaseParameters, mapping);
+    bool ods = parameters.GetOneBool("ods", false);
+    std::vector<Float> ep = parameters.GetFloatArray("eyepos");
+    Point3f eyePos(0, 0, 0);
+    if (ep.size() == 3)
+        eyePos = Point3f(ep[0], ep[1], ep[2]);
+    Float yaw = Radians(parameters.GetOneFloat("yaw", 0.f));
+    Float ipd = parameters.GetOneFloat("ipd", 0.064f);
+    std::string e = parameters.GetOneString("eye", "mono");
+    int eye = e == "left" ? -1 : (e == "right" ? 1 : 0);
+    return alloc.new_object<SphericalCamera>(cameraBaseParameters, mapping, ods, eyePos,
+                                             yaw, ipd, eye);
 }
 
